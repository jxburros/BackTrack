{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BackTrack",
  "mainBinaryName": "backtrack",
  "version": "../../package.json",
  "identifier": "com.jxburros.backtrack.hub",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "jxburros",
    "copyright": "Copyright (c) jxburros. MIT licence.",
    "category": "Music",
    "shortDescription": "BackTrack: song in, stems and MIDI out. Runs on your machine.",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "resources": { "trainer/": "trainer/" },
    "icon": [
      "icons/hub/32x32.png",
      "icons/hub/128x128.png",
      "icons/hub/128x128@2x.png",
      "icons/hub/icon.icns",
      "icons/hub/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
