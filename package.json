{
  "name": "@jxburros/backtrack",
  "version": "0.1.0",
  "private": true,
  "description": "BackTrack - stem separator (Explode) and MIDI transcriber (Surveil) on ggml.",
  "license": "MIT",
  "vendor": ["ggml"],
  "scripts": {
    "postinstall": "node scripts/install-vendor.js",
    "vendor": "bash scripts/vendor.sh --spec ggml",
