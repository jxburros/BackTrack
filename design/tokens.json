{
  "$description": "BackTrack design tokens. Source of truth for design/backtrack.css and design/AGENT-SPEC.md. Colors are sRGB hex; sizes are px unless noted.",
  "version": "0.1.0",
  "fonts": {
    "shout": { "family": "Anton", "weights": [400], "fallback": "Impact, 'Arial Narrow Bold', sans-serif" },
    "work": { "family": "Space Mono", "weights": [400, 700], "fallback": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace" },
    "scrawl": { "family": "Permanent Marker", "weights": [400], "fallback": "'Comic Sans MS', cursive", "licence": "Apache-2.0" },
    "stencil": { "family": "Big Shoulders Stencil Display", "weights": [900], "fallback": "Anton, Impact, sans-serif", "min_size": 40 },
    "crt": { "family": "VT323", "weights": [400], "fallback": "ui-monospace, monospace", "min_size": 20 },
    "flyer": { "family": ["UnifrakturMaguntia", "Rubik Mono One", "Special Elite"], "weights": [400], "scope": "gig-flyer only" }
  },
  "type_scale": {
    "shout": { "font": "shout", "size": "clamp(64px, 9vw, 160px)", "line_height": 0.95, "letter_spacing": "-0.01em", "case": "upper", "max_per_screen": 1 },
    "heading": { "font": "shout", "size": 48, "line_height": 1.0, "case": "upper" },
    "app_title": { "font": "theme display (stencil | crt | shout)", "size": "clamp(72px, 8vw, 150px)", "line_height": 0.95 },
    "body": { "font": "work", "weight": 400, "size": 18, "line_height": 1.45 },
    "ui": { "font": "work", "weight": 700, "size": 16, "line_height": 1.3 },
    "button": { "font": "work", "weight": 700, "size": 22, "letter_spacing": "0.08em", "case": "upper" },
    "label": { "font": "work", "weight": 700, "size": 15, "letter_spacing": "0.14em", "case": "upper" },
    "caption": { "font": "work", "weight": 400, "size": 14, "line_height": 1.4 },
    "scrawl": { "font": "scrawl", "size": "30-46", "line_height": 1.1, "case": "upper (font is caps)" }
  },
  "space": { "unit": 8, "scale": [4, 8, 16, 24, 32, 48, 64, 96], "page_margin": 64, "page_margin_mobile": 16 },
  "border": { "hairline": 2, "standard": 3, "heavy": 4, "radius": 0 },
  "tilt": { "decor_deg": [1, 4], "headline_deg": [1, 3], "controls_deg": 0, "directions": "mix negative and positive; never all the same way" },
  "grain": { "surface_opacity": [0.05, 0.09], "display_type_opacity": [0.15, 0.25], "body_text": 0 },
  "motion": { "duration_ms": [80, 160], "easing": "steps(2) or cubic-bezier(.2,.9,.3,1)", "reduced_motion": "no shake, no flicker; instant state changes" },
  "themes": {
    "xerox-riot": {
      "scope": "Hub, settings, run history; light mode for every app",
      "mode": "light",
      "color": {
        "bg": "#F1EFE9", "surface": "#F7F5EF", "surface-2": "#BDB8AD", "ink": "#0D0D0D", "ink-muted": "#5D5A53",
        "accent": "#E10600", "accent-text": "#C20500", "on-accent": "#F1EFE9",
        "tape": "#E8DCB0", "danger": "#C20500", "focus": "#E10600",
        "rec": "#E10600", "roll-bg": "#F7F5EF", "grid": "#BDB8AD", "grid-strong": "#5D5A53", "note-dim": "#BDB8AD"
      },
      "display_font": "shout"
    },
    "blast-zone": {
      "scope": "Backtrack Explode (stem separator)",
      "mode": "dark",
      "color": {
        "bg": "#111110", "surface": "#1A1A18", "surface-2": "#232320", "track": "#2B2B27", "ink": "#F1EFE9", "ink-muted": "#8C8670",
        "accent": "#FFD400", "on-accent": "#0D0D0D", "flash": "#FF6A00", "on-flash": "#0D0D0D",
        "tape": "#E8DCB0", "danger": "#FF5A4A", "focus": "#FFD400"
      },
      "display_font": "stencil",
      "stem_colors": { "vocals": "#FF6A00", "default": "#FFD400" }
    },
    "wiretap": {
      "scope": "Backtrack Surveil (MIDI transcriber)",
      "mode": "dark",
      "color": {
        "bg": "#07110A", "surface": "#0A170E", "surface-2": "#06100A", "roll-bg": "#06100A", "grid": "#123A1E", "grid-strong": "#1D5A30",
        "ink": "#39FF6A", "ink-muted": "#3F8F55", "note-dim": "#1F6B35",
        "accent": "#39FF6A", "on-accent": "#07110A", "rec": "#E10600", "danger": "#FF5A4A", "focus": "#39FF6A"
      },
      "display_font": "crt",
      "scanlines": { "height": 2, "period": 6, "color": "#000000", "opacity": 0.22 }
    },
    "gig-flyer": {
      "scope": "Release pages, social images, changelogs. Never inside the apps.",
      "mode": "light",
      "color": { "bg": "#F5F3EE", "ink": "#0D0D0D", "ink-muted": "#5D5A53", "accent": "#FF2E93", "accent-2": "#D6FF2E", "xerox": "#BDB8AD", "tape": "#E8DCB0" },
      "display_font": "flyer"
    }
  },
  "contrast_checked": {
    "ink on bone": 16.9, "ink-muted #5D5A53 on bone": 5.98, "accent-text #C20500 on bone": 5.51, "accent #E10600 on bone": 4.32,
    "hazard on #1A1A18": 12.18, "flash on #1A1A18": 6.07, "ink-muted #8C8670 on #1A1A18": 4.78, "ink on hazard": 13.58, "ink on flash": 6.77,
    "phosphor on #0A170E": 13.74, "ink-muted #3F8F55 on #0A170E": 4.62, "note-dim #1F6B35 on #0A170E": 2.81, "rec #E10600 on #0A170E": 3.7, "danger #FF5A4A on #07110A": 6.23,
    "grid-strong #5D5A53 on roll-bg #F7F5EF": 6.31, "ink on note-dim #BDB8AD (light roll outline)": 9.83
  }
}
